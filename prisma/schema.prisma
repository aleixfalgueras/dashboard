// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                String    @id @default(cuid())
  name              String
  slug              String    @unique
  statsDataStartDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  instagramProfile InstagramProfile?
  tiktokProfile    TiktokProfile?
  linkedinProfile  LinkedinProfile?
  youtubeProfile   YoutubeProfile?
  uploads          Upload[]

  @@index([slug])
}

model InstagramProfile {
  id             String   @id @default(cuid())
  clientId       String   @unique
  username       String
  followersCount Int      @default(0)
  followingCount Int      @default(0)
  postsCount     Int      @default(0)
  fullName       String?
  bio            String?
  profilePicUrl  String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  InstagramPost[]
}

model InstagramPost {
  id               String   @id @default(cuid())
  profileId        String
  postId           String   @unique
  type             String
  shortCode        String
  caption          String?
  url              String
  likesCount       Int
  commentsCount    Int
  timestamp        DateTime
  displayUrl       String?
  dimensionsHeight Int?
  dimensionsWidth  Int?
  isSponsored      Boolean  @default(false)
  isPinned         Boolean  @default(false)
  locationName     String?
  locationId       String?
  hashtags         String[]
  mentions         String[]
  images           String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile  InstagramProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  comments InstagramComment[]

  @@index([profileId])
  @@index([timestamp])
}

model InstagramComment {
  id              String   @id @default(cuid())
  postId          String
  commentId       String   @unique
  text            String
  ownerUsername   String
  ownerProfilePic String?
  timestamp       DateTime
  likesCount      Int      @default(0)
  repliesCount    Int      @default(0)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  post InstagramPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Upload {
  id          String   @id @default(cuid())
  clientId    String
  filename    String
  processedAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model TiktokProfile {
  id        String   @id @default(cuid())
  clientId  String   @unique
  username  String
  nickname  String?
  signature String?
  verified  Boolean  @default(false)
  fans      Int      @default(0)
  following Int      @default(0)
  friends   Int      @default(0)
  heart     Int      @default(0)
  video     Int      @default(0)
  digg      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  TiktokPost[]
}

model TiktokPost {
  id               String   @id @default(cuid())
  profileId        String
  postId           String   @unique
  text             String?
  textLanguage     String?
  createTime       DateTime
  isAd             Boolean  @default(false)
  webVideoUrl      String
  diggCount        Int      @default(0)
  shareCount       Int      @default(0)
  playCount        Int      @default(0)
  collectCount     Int      @default(0)
  commentCount     Int      @default(0)
  isSlideshow      Boolean  @default(false)
  isPinned         Boolean  @default(false)
  isSponsored      Boolean  @default(false)
  hashtags         String[]
  mentions         String[]
  musicName        String?
  musicAuthor      String?
  musicOriginal    Boolean  @default(false)
  videoDuration    Int?
  videoHeight      Int?
  videoWidth       Int?
  videoCoverUrl    String?
  videoDefinition  String?
  videoFormat      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  profile TiktokProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createTime])
}

model LinkedinProfile {
  id            String   @id @default(cuid())
  clientId      String   @unique
  firstName     String
  lastName      String
  headline      String?
  username      String
  profileUrl    String
  profilePicUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  posts  LinkedinPost[]
}

model LinkedinPost {
  id                String   @id @default(cuid())
  profileId         String
  urn               String   @unique
  fullUrn           String
  postType          String
  text              String?
  url               String
  postedAt          DateTime
  totalReactions    Int      @default(0)
  likesCount        Int      @default(0)
  supportsCount     Int      @default(0)
  lovesCount        Int      @default(0)
  insightsCount     Int      @default(0)
  celebratesCount   Int      @default(0)
  commentsCount     Int      @default(0)
  repostsCount      Int      @default(0)
  mediaType         String?
  mediaUrl          String?
  mediaThumbnail    String?
  imageUrls         String[]
  paginationToken   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile LinkedinProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([postedAt])
}

model YoutubeProfile {
  id                    String   @id @default(cuid())
  clientId              String   @unique
  channelId             String
  channelName           String
  channelUsername       String?
  channelUrl            String
  channelDescription    String?
  channelAvatarUrl      String?
  channelBannerUrl      String?
  channelLocation       String?
  channelJoinedDate     String?
  numberOfSubscribers   Int      @default(0)
  channelTotalVideos    Int      @default(0)
  channelTotalViews     Int      @default(0)
  isChannelVerified     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  client Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  videos YoutubeVideo[]

  @@index([channelId])
}

model YoutubeVideo {
  id             String   @id @default(cuid())
  profileId      String
  videoId        String   @unique
  title          String
  type           String
  url            String
  thumbnailUrl   String?
  viewCount      Int      @default(0)
  likes          Int      @default(0)
  commentsCount  Int      @default(0)
  publishedAt    DateTime
  duration       String?
  text           String?
  location       String?
  hashtags       String[]
  isAgeRestricted Boolean  @default(false)
  isMonetized    Boolean?
  isMembersOnly  Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profile YoutubeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([publishedAt])
}
